        480,
        0
      ],
      "retryOnFail": true
    },
    {
      "parameters": {
        "jsCode": "// DUE FOR REMINDER\n// pending_approval for more than REMIND_AFTER_HOURS (since last change, Airtable's updated_at), and not reminded in the last REMIND_EVERY_HOURS.\nconst cfg = $('CONFIG').first().json;\nconst after = Number(cfg.REMIND_AFTER_HOURS ?? 24), every = Number(cfg.REMIND_EVERY_HOURS ?? 24);\nconst now = DateTime.now();\nconst out = [];\nfor (const item of $input.all()) {\n  const r = item.json; if (!r || !r.id || !r.slack_message_ts) continue;\n  const changed = r.updated_at ? DateTime.fromISO(String(r.updated_at)) : null;\n  const reminded = r.last_reminded_at ? DateTime.fromISO(String(r.last_reminded_at)) : null;\n  const waitingH = changed && changed.isValid ? now.diff(changed, 'hours').hours : Infinity;\n  const sinceRemindH = reminded && reminded.isValid ? now.diff(reminded, 'hours').hours : Infinity;\n  if (waitingH >= after && sinceRemindH >= every) {\n    out.push({ json: { id: r.id, topic: r.topic, slack_message_ts: r.slack_message_ts, waiting_hours: Math.round(waitingH),\n      reminder_text: `${cfg.MENTION} reminder: *${r.topic}* has been waiting for approval for ${Math.round(waitingH)} h. Please approve, reject or edit above.` } });\n  }\n}\nreturn out;\n"
      },
      "id": "111a4d95-8003-4fbd-a7f8-d4913e25e012",
      "name": "DUE FOR REMINDER",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://slack.com/api/chat.postMessage",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "slackApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ channel: $('CONFIG').first().json.SLACK_APPROVALS_CHANNEL, thread_ts: $json.slack_message_ts, text: $json.reminder_text, reply_broadcast: true }) }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "0fca981d-06ce-41b3-a23f-5d1d401f81f0",
      "name": "SLACK: thread reminder",
