    },
    {
      "parameters": {
        "jsCode": "// EXTRACT ERROR (n8n Error Trigger payload)\nconst e = $input.first().json || {};\nconst ex = e.execution || {}, wf = e.workflow || {};\nconst err = ex.error || {};\nconst message = String(err.message || err.description || 'unknown error').slice(0, 500);\nreturn [{ json: {\n  failed_execution_id: String(ex.id || ''), execution_url: ex.url || '', workflow_name: wf.name || '', workflow_id: wf.id || '',\n  last_node: ex.lastNodeExecuted || '', error_message: message, mode: ex.mode || '', when: DateTime.now().setZone('UTC').toFormat('dd LLL yyyy HH:mm'),\n  airtable_error: `crash in ${wf.name || 'workflow'} at \"${ex.lastNodeExecuted || '?'}\": ${message}`.slice(0, 900),\n} }];\n"
      },
      "id": "f9f5c1c2-eee7-43d7-b8ec-72b6938e2dc0",
      "name": "EXTRACT ERROR",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ]
    },
    {
